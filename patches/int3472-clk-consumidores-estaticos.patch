diff --git a/drivers/platform/x86/intel/int3472/tps68470.c b/drivers/platform/x86/intel/int3472/tps68470.c
index 0133405..f57a234 100644
--- a/drivers/platform/x86/intel/int3472/tps68470.c
+++ b/drivers/platform/x86/intel/int3472/tps68470.c
@@ -113,6 +113,26 @@ skl_int3472_fill_clk_pdata(struct device *dev, struct tps68470_clk_platform_data
 		n_consumers++;
 
 	if (!n_consumers) {
+		const struct int3472_tps68470_board_data *board_data =
+			int3472_tps68470_get_board_data(dev_name(dev));
+
+		if (board_data && board_data->n_clk_consumers) {
+			n_consumers = board_data->n_clk_consumers;
+			*clk_pdata = devm_kzalloc(dev, struct_size(*clk_pdata, consumers, n_consumers),
+						  GFP_KERNEL);
+			if (!*clk_pdata)
+				return -ENOMEM;
+
+			(*clk_pdata)->n_consumers = n_consumers;
+			for (i = 0; i < n_consumers; i++)
+				(*clk_pdata)->consumers[i].consumer_dev_name =
+					board_data->clk_consumers[i];
+
+			dev_info(dev, "No ACPI dependents, using %u static clock consumer(s)\n",
+				 n_consumers);
+			return n_consumers;
+		}
+
 		dev_err(dev, "INT3472 seems to have no dependents\n");
 		return -ENODEV;
 	}
